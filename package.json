{
  "name": "teleplug",
  "version": "1.0.0",
  "description": "TelePlug: 24/7 Telegram Auto-Plugger and Smart Message Forwarder with React + Vite Dashboard",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build && tsc -p tsconfig.server.json",
    "prestart": "node -e \"if (!require('fs').existsSync('dist/server/index.js')) require('child_process').execSync('npm run build', {stdio:'inherit'})\"",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "userbot",
    "auto-plugger",
    "message-forwarder",
    "mtproto"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mtcute/dispatcher": "^0.22.2",
    "@mtcute/node": "^0.22.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
